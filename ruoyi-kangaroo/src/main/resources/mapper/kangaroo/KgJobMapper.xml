    <!--
      后台"整表单编辑"专用的全量更新。

      为什么要和 updateKgJob 拆成两条语句：
      updateKgJob 全是 <if test="x != null">，语义是"没传的列保持原值"。
      内部的局部更新需要这个语义 —— changeStatus 只 set jobId/status/publishTime 就调它，
      一旦把 start_date 之类改成无条件 SET，一次上下架就会把可开始日期清成 NULL。
      但对后台表单来说，"没传"恰恰等于"运营把这个可选项清空了"：动态 SET 会整列跳过，
      于是出现"弹了修改成功、库里没变"（只有 update_time 被刷新）。
      两种语义无法共存，所以后台编辑单独走这条全量语句，内部路径继续用 updateKgJob。

      列的分档：
      1) 必填列（store_id / job_type / title / city / headcount / salary_type）：无条件 SET。
         KgJobServiceImpl.updateKgJob 已在入参本身上跑过 validate()（不再回落到库里的旧值），
         保证它们非空，不会把 NOT NULL 列写成 NULL。
      2) 可清空列：无条件 SET，运营清空就写 NULL。即
         cover、address、salary_min、salary_max、salary_unit、settle_desc、start_date、
         min_days、daily_hours、shift_desc、shift_time、train_desc、probation、benefits、
         deliver_desc、est_hours、publisher_name、board_desc、tags、content、requirement、remark。
         显式写 jdbcType：传 null 时 JDBC 驱动无法从 Java 侧推断类型，不写容易踩到设置空值失败。
         latitude / longitude（V42 工作地点坐标）也无条件 SET，但后台表单里没有这两个输入框：
         保留库里的点还是清掉，由 KgJobServiceImpl.applyLocation 先算好再交给这里（没改地点就带回原坐标，改了地点文字就置空）。
      3) 有数据库默认值的开关/枚举列（board_type / insurance_flag / remote_flag / month_redpacket）：仍带 <if> 判空。
         它们在后台表单里是单选/下拉，界面上根本清不空；真收到 null 时保留原值，
         比把小程序端依赖的枚举写成 NULL 更安全。
      4) 不在本语句里的列：hired_count / applied_count 由 increaseHiredCount 等统计接口维护，
         status / publish_time / close_time 由 changeStatus 维护，del_flag 归逻辑删除。
         后台编辑无论传什么都碰不到它们。

      where 里除主键外只剩名额兜底那一条，见它自己位置上的说明。

      这里刻意不做基于 update_time 的乐观锁。update_time 不是这张表的版本号：
      increaseAppliedCount（每一次 C 端报名）、increase/decreaseHiredCount、recalcCounters
      都会刷新它，而它们改的列后台编辑表单一个都不涉及。拿它当版本比对的结果是
      "运营打开表单期间随便谁报个名，保存就被判成冲突"，热门岗位在招聘期可以反复触发，
      一次全量重算更会把当时所有摊开的表单一次性作废 —— 误拒的代价远大于它能挡住的覆盖。
      真要做并发覆盖检测，得另加一列只由后台编辑自增的 version，那是 DDL 的事。
    -->
    <update id="updateKgJobByAdmin" parameterType="KgJob">
        update kg_job
        set <if test="sortNo != null">sort_no = #{sortNo},</if>
            store_id      = #{storeId},
            recruit_store_id = #{recruitStoreId},
            job_type      = #{jobType},
            title         = #{title},
            city          = #{city},
            headcount     = #{headcount},
            salary_type   = #{salaryType},
            cover          = #{cover, jdbcType=VARCHAR},
            address        = #{address, jdbcType=VARCHAR},
            latitude       = #{latitude, jdbcType=DECIMAL},
            longitude      = #{longitude, jdbcType=DECIMAL},
            salary_min     = #{salaryMin, jdbcType=DECIMAL},
            salary_max     = #{salaryMax, jdbcType=DECIMAL},
            salary_unit    = #{salaryUnit, jdbcType=VARCHAR},
            bonus_desc     = #{bonusDesc, jdbcType=VARCHAR},
            commission_desc = #{commissionDesc, jdbcType=VARCHAR},
            settle_desc    = #{settleDesc, jdbcType=VARCHAR},
            start_date     = #{startDate, jdbcType=DATE},
            min_days       = #{minDays, jdbcType=INTEGER},
            daily_hours    = #{dailyHours, jdbcType=VARCHAR},
            shift_desc     = #{shiftDesc, jdbcType=VARCHAR},
            shift_time     = #{shiftTime, jdbcType=VARCHAR},
            train_desc     = #{trainDesc, jdbcType=VARCHAR},
            probation      = #{probation, jdbcType=VARCHAR},
            benefits       = #{benefits, jdbcType=VARCHAR},
            deliver_desc   = #{deliverDesc, jdbcType=VARCHAR},
            est_hours      = #{estHours, jdbcType=VARCHAR},
            publisher_name = #{publisherName, jdbcType=VARCHAR},
            board_desc     = #{boardDesc, jdbcType=VARCHAR},
            tags           = #{tags, jdbcType=VARCHAR},
            content        = #{content, jdbcType=VARCHAR},
            requirement    = #{requirement, jdbcType=VARCHAR},
            remark         = #{remark, jdbcType=VARCHAR},
            <if test="boardType != null and boardType != ''">board_type = #{boardType},</if>
            <if test="insuranceFlag != null and insuranceFlag != ''">insurance_flag = #{insuranceFlag},</if>
            <if test="remoteFlag != null and remoteFlag != ''">remote_flag = #{remoteFlag},</if>
            <!-- 满月红包（V44）：老版本后台表单不带这个字段时保持原值 -->
            <if test="monthRedpacket != null and monthRedpacket != ''">month_redpacket = #{monthRedpacket},</if>
            <!-- 换工类型：Service 已归一（非换工岗位为 ''）；为 null 只在老版本后台表单不带这个字段时出现，此时保持原值 -->
            <if test="workKind != null">work_kind = #{workKind},</if>
            <!--
              筛选条件（V48）：Service 已按白名单和岗位类型收口（KgJobServiceImpl.applyFilterFields，非空串即已校验）；
              为 null 只在老版本后台表单不带这几个字段、又找不到原值时出现，此时保持原值
            -->
            <if test="genderPref != null">gender_pref = #{genderPref},</if>
            <if test="genderCountsEnabled != null">
                gender_male_count = #{genderMaleCount,jdbcType=INTEGER},
                gender_female_count = #{genderFemaleCount,jdbcType=INTEGER},
            </if>
            <if test="restMode != null">rest_mode = #{restMode},</if>
            <if test="roomType != null">room_type = #{roomType},</if>
            <!-- 岗位照片（V49）：Service 已校验（JobImages.parse）并把封面同步成第一张；为 null 只在老版本后台表单不带这个字段时出现，此时保持原值 -->
            <if test="images != null">images = #{images},</if>
            <!-- 招募表单新字段（V66）：Service 已校验并收口（KgJobServiceImpl.applyExtras）；为 null 只在老版本后台表单不带这几个字段时出现，此时保持原值 -->
            <if test="mealAllowance != null">meal_allowance = #{mealAllowance},</if>
            <if test="mealAllowanceUnit != null">meal_allowance_unit = #{mealAllowanceUnit},</if>
            <if test="petStatus != null">pet_status = #{petStatus},</if>
            <if test="petImages != null">pet_images = #{petImages},</if>
            <if test="lodgingImages != null">lodging_images = #{lodgingImages},</if>
            <if test="lodgingVideo != null">lodging_video = #{lodgingVideo},</if>
            <if test="lodgingVideoCover != null">lodging_video_cover = #{lodgingVideoCover},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        where job_id = #{jobId} and del_flag = '0'
        <!--
          名额兜底：这条语句自己保证写不出 hired_count 超过 headcount 的非法岗位。
          Service 里也有一次同样的比较，但它拿的是先查出来的旧行，并发确认录用会从
          "查"和"写"之间穿过去；只有条件落在 where 上、由 InnoDB 在行锁下求值，才真的拦得住。
          影响 0 行时上层回查一次再报错，见 KgJobServiceImpl.explainFailedAdminUpdate。

          两个 is null 分支不能省。SQL 三值逻辑里只要有一边是 null，比较结果就是 null，
          既不真也不假，整条 where 随之不成立：headcount 没传（本模块的调用方跑过 validate
          必然非空，但语句不该指望调用方的自觉）或库里 hired_count 为 NULL 时，
          少了这两支就会把一次正常编辑判成 0 行，再被上层报成并发冲突，答非所问。
        -->
        and (#{headcount, jdbcType=INTEGER} is null
             or hired_count is null
             or #{headcount, jdbcType=INTEGER} &gt;= hired_count)
    </update>

    <update id="deleteKgJobByJobIds">
        update kg_job set del_flag = '2', update_by = #{updateBy}, update_time = sysdate()
        where job_id in
        <foreach item="jobId" collection="jobIds" open="(" separator="," close=")">
            #{jobId}
        </foreach>
        and del_flag = '0'
    </update>

    <select id="countByStoreId" resultType="int">
        select count(1) from kg_job where (store_id = #{storeId} or recruit_store_id = #{storeId}) and del_flag = '0'
    </select>

    <update id="increaseAppliedCount">
        update kg_job set applied_count = applied_count + 1, update_time = sysdate()
        where job_id = #{jobId} and del_flag = '0'
    </update>

    <!-- hired_count &lt; headcount 放进 where：由数据库行锁保证并发录用不会超额，返回 0 即名额已满（或岗位已下架 / 草稿，调用方再读一次区分） -->
    <update id="increaseHiredCount">
        update kg_job set hired_count = hired_count + 1, update_time = sysdate()
        where job_id = #{jobId} and del_flag = '0' and hired_count &lt; headcount
          and status in ('published', 'paused')
    </update>

    <update id="decreaseHiredCount">
        <!-- hired_count > 0 是下限保护：即便上层重复调用也不会把计数减成负数 -->
        update kg_job set hired_count = hired_count - 1, update_time = sysdate()
        where job_id = #{jobId} and del_flag = '0' and hired_count &gt; 0
    </update>

    <update id="recalcCounters">
        <!--
          按 kg_application 的实际行数重算冗余统计列。
          hired_count 只数"已扣过名额"的状态；applied_count 是累计报名人数，
          撤回/驳回不回退，所以只排除逻辑删除行。
        -->
        update kg_job j set
            j.applied_count = (select count(1) from kg_application a
                                where a.job_id = j.job_id and a.del_flag = '0'),
            j.hired_count = (select count(1) from kg_application a
                              where a.job_id = j.job_id and a.del_flag = '0'
                                and a.status in ('store_confirmed', 'contract_signed', 'onboarded')),
            j.update_time = sysdate()
        where j.del_flag = '0'
        <if test="jobId != null"> and j.job_id = #{jobId}</if>
    </update>

</mapper>
