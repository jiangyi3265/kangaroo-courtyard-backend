<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.kangaroo.mapper.KgApplicationLogMapper">

    <resultMap type="KgApplicationLog" id="KgApplicationLogResult">
        <result property="logId"        column="log_id"        />
        <result property="appId"        column="app_id"        />
        <result property="fromStatus"   column="from_status"   />
        <result property="toStatus"     column="to_status"     />
        <result property="operatorType" column="operator_type" />
        <result property="operatorId"   column="operator_id"   />
        <result property="operatorName" column="operator_name" />
        <result property="reason"       column="reason"        />
        <result property="createTime"   column="create_time"   />
    </resultMap>

    <sql id="selectKgApplicationLogVo">
        select log_id, app_id, from_status, to_status, operator_type, operator_id, operator_name,
               reason, create_time
        from kg_application_log
    </sql>

    <!--
      流水表只追加，所以没有 del_flag 过滤。
      create_time 一律由数据库 sysdate() 写入，不取调用方传入的值：
      发生时间必须是服务端的真实时刻，否则审计流水可以被伪造成任意顺序。
    -->
    <insert id="insertKgApplicationLog" parameterType="KgApplicationLog" useGeneratedKeys="true" keyProperty="logId">
        insert into kg_application_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="appId != null">app_id,</if>
            <if test="fromStatus != null">from_status,</if>
            <if test="toStatus != null">to_status,</if>
            <if test="operatorType != null">operator_type,</if>
            <if test="operatorId != null">operator_id,</if>
            <if test="operatorName != null">operator_name,</if>
            <if test="reason != null">reason,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appId != null">#{appId},</if>
            <if test="fromStatus != null">#{fromStatus},</if>
            <if test="toStatus != null">#{toStatus},</if>
            <if test="operatorType != null">#{operatorType},</if>
            <if test="operatorId != null">#{operatorId},</if>
            <if test="operatorName != null">#{operatorName},</if>
            <if test="reason != null">#{reason},</if>
            sysdate()
        </trim>
    </insert>

    <!-- 正序返回：详情页时间轴按发生先后展示；log_id 自增，比 create_time 更能保证同秒内的先后 -->
    <select id="selectByAppId" resultMap="KgApplicationLogResult">
        <include refid="selectKgApplicationLogVo"/>
        where app_id = #{appId}
        order by log_id asc
    </select>

</mapper>
